# AnimeOrbit — Environment Configuration Example
# Copy this file to .env and fill in your actual values

# ============================================
# AI PROVIDERS (Choose at least one)
# ============================================
# Primary AI provider for recommendations
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI as fallback AI provider
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# OPTIONAL APIS
# ============================================
# YouTube API for trailer embeds
YOUTUBE_API_KEY=your_youtube_api_key_here

# IMDB API for search fallback (optional - improves search speed and reliability)
IMDB_API_KEY=your_imdb_api_key_here

# AniList API credentials (optional)
ANILIST_CLIENT_ID=your_anilist_client_id_here
ANILIST_CLIENT_SECRET=your_anilist_client_secret_here

# ============================================
# SUPABASE (REQUIRED)
# ============================================
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Client-side Supabase variables (auto-synced with above)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# Client-side IMDB API key
VITE_IMDB_API_KEY=your_imdb_api_key_here

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 1. Create a Supabase project at https://supabase.com
# 2. Go to Project Settings > API to get your credentials
# 3. Run the Supabase SQL setup script in supabase/ directory
# 4. Get a Gemini API key from https://makersuite.google.com/app/apikey
# 5. Fill in the values above and rename this file to .env
